{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@worldforge/core": ["./packages/core/src/index.ts"],
      "@worldforge/world-gen": ["./packages/world-gen/src/index.ts"],
      "@worldforge/prefabs": ["./packages/prefabs/src/index.ts"],
      "@worldforge/quality": ["./packages/quality/src/index.ts"],
      "@worldforge/roblox-export": ["./packages/roblox-export/src/index.ts"],
      "@worldforge/roblox-cloud": ["./packages/roblox-cloud/src/index.ts"],
      "@worldforge/agents": ["./packages/agents/src/index.ts"]
    }
  }
}
