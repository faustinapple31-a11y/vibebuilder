{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WorldForge AI main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-title",
    "shell:allow-open",
    "dialog:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close"
  ]
}
