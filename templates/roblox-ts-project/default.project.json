{
  "name": "__PROJECT_SLUG__",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": { "$path": "node_modules/@rbxts" }
        }
      },
      "TS": { "$path": "out/shared" },
      "WorldAssets": { "$path": "assets/world" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TS": { "$path": "out/server" },
      "World": { "$path": "out/world" },
      "Systems": { "$path": "out/systems" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TS": { "$path": "out/client" },
        "UI": { "$path": "out/ui" }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 900
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14,
        "Brightness": 2,
        "GlobalShadows": true
      }
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": { "HttpEnabled": true }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
