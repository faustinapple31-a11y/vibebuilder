# WorldForge AI — local secrets & Roblox ids (copy to `.env`; `.env` is git-ignored and never leaves this machine)
#
# Keys are read by the Rust backend only (never sent to the webview or to any WorldForge server).
# Settings → Keys (OS secure storage) has priority over this file when both are set.

# Roblox Open Cloud API key — create.roblox.com → Open Cloud → API keys
# Scopes: universe-places:write, universe:read, universe.place:write (publish)
#         asset:read, asset:write (Hero 3D models → Model assets)
ROBLOX_OPEN_CLOUD_API_KEY=

# Owner of uploaded assets = the account (or group) the key belongs to
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=

# Optional: default experience for publishing (also editable in the Roblox tab)
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Optional AI providers (all paid; leave empty to use Roblox Studio's own free 3D generator via MCP)
MESHY_API_KEY=
GEMINI_IMAGE_API_KEY=
ELEVENLABS_API_KEY=
